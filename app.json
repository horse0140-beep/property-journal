{
  "expo": {
    "name": "Property Journal",
    "slug": "homewise",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "homewise",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/property-journal-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2460"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homewise.app",
      "buildNumber": "1",
      "requireFullScreen": false,
      "infoPlist": {
        "CFBundleDisplayName": "Property Journal",
        "NSPhotoLibraryUsageDescription": "Property Journal uses your photo library to attach photos to repairs, appliances, and home records.",
        "NSPhotoLibraryAddUsageDescription": "Property Journal saves generated reports to your photo library.",
        "NSCameraUsageDescription": "Property Journal uses your camera to photograph appliances, receipts, and home repairs.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.homewise.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2460"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/property-journal-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F2460",
          "imageWidth": 280
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Property Journal uses your photos to attach images to repairs and appliances.",
          "cameraPermission": "Property Journal uses your camera to photograph appliances and receipts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A3C8F",
          "defaultChannel": "maintenance"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72fef5c5-a58d-4540-853f-85c910ce3a3e"
      }
    },
    "owner": "horse536"
  }
}
