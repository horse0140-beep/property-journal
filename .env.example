# Copy this file to .env and fill in your values
# Do NOT commit .env to version control

# Anthropic API key for the AI Home Assistant feature
# Get yours at: https://console.anthropic.com/
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase project credentials
# Get yours at: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=YOUR_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_KEY

# Premium feature share URLs (your web app endpoints)
EXPO_PUBLIC_SHARE_BASE_URL=https://homewise.app/share
EXPO_PUBLIC_CONTRACTOR_PORTAL_URL=https://homewise.app/contractor

# Stripe billing (use Checkout API URL or Payment Links)
EXPO_PUBLIC_STRIPE_CHECKOUT_URL=
EXPO_PUBLIC_STRIPE_PORTAL_URL=
EXPO_PUBLIC_STRIPE_LINK_PREMIUM=
EXPO_PUBLIC_STRIPE_LINK_LANDLORD=
EXPO_PUBLIC_STRIPE_LINK_REALTOR=

# RevenueCat (in-app subscriptions — optional, requires native build)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
