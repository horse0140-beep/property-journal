# Copy this file to .env and fill in your values
# Do NOT commit .env to version control

# Anthropic API key for the AI Home Assistant feature
# Get yours at: https://console.anthropic.com/
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase project credentials
# Get yours at: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=YOUR_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_KEY

# Optional: override auth email redirect (defaults to expo-linking deep link)
# Production native build: homewise://auth/callback
# EXPO_PUBLIC_AUTH_REDIRECT_URL=homewise://auth/callback

# Public HTTPS site origin for property share links (must be a deployed web app).
# Format: origin only — do NOT append /share (the app adds /share/<token>):
#   EXPO_PUBLIC_SHARE_BASE_URL=https://property-journal.vercel.app
# Generated URL: https://property-journal.vercel.app/share/<token>
# The web app must serve /share/<token> (see vercel.json rewrites).
# Do NOT use homewise.app unless that domain is actually deployed.
EXPO_PUBLIC_SHARE_BASE_URL=

# Optional: POST each share forensic STEP/FAIL (for remote Android console capture)
# EXPO_PUBLIC_SHARE_FORENSICS_URL=https://your-webhook.example/share-forensics

# Optional: contractor portal web URL (same deployment requirements)
EXPO_PUBLIC_CONTRACTOR_PORTAL_URL=

# Stripe billing (use Checkout API URL or Payment Links)
EXPO_PUBLIC_STRIPE_CHECKOUT_URL=
EXPO_PUBLIC_STRIPE_PORTAL_URL=
EXPO_PUBLIC_STRIPE_LINK_PREMIUM=
EXPO_PUBLIC_STRIPE_LINK_LANDLORD=
EXPO_PUBLIC_STRIPE_LINK_REALTOR=

# RevenueCat (in-app subscriptions — optional, requires native build)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
